@startuml deployment
title Deployment-01 · UML Deployment Diagram (BrewLite Production & Environments)

skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 150
skinparam roundcorner 6

skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam database {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #1E3A8A
}

skinparam rectangle {
  BorderColor #64748B
  FontColor #1E293B
}

skinparam component {
  BackgroundColor #FEF3C7
  BorderColor #D97706
  FontColor #78350F
}

skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #1E293B
}

skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #B45309
  FontSize 11
}

node "Thiết bị người dùng\n(Điện thoại / Máy tính)" <<device>> as device {
  artifact "Trình duyệt Web\n(Browser / PWA)" as browser
}

rectangle "Local (docker-compose)" as local #F1F5F9 {
  node "brewlite-web\n(Next.js :3000)" as web_local
  node "brewlite-api\n(NestJS :3001)" as api_local
  database "brewlite-db\n(PostgreSQL :5432)\n[Volume: pgdata]" as db_local
  
  web_local --> api_local : HTTP :3001
  api_local --> db_local : PostgreSQL :5432
}

rectangle "CI (GitHub Actions)" as ci #FEF9C3 {
  component "Runner\n(ubuntu-latest)" as runner
  component "Docker Build & Test\n(Build Args: NEXT_PUBLIC_*)" as build
  component "Container Registry\nGitHub Packages (ghcr.io)" as ghcr

  runner ..> build : execute
  build --> ghcr : push Docker image (SHA/tag)
}

rectangle "Production (Render)" as prod #F0FDF4 {
  node "Render Web Service\nbrewlite-web" as web_prod {
    artifact "ghcr.io/nhom6cnpm/brewlite-web:<sha>" as img_web
  }

  node "Render Web Service\nbrewlite-api" as api_prod {
    artifact "ghcr.io/nhom6cnpm/brewlite-api:<sha>" as img_api
  }

  database "Render Managed PostgreSQL\nbrewlite-db (:5432)\n[Persistent Storage - 30 days]" as db_prod
}

browser --> web_prod : HTTPS :443\n(https://brewlite-web.onrender.com)
browser --> api_prod : HTTPS :443\n(https://brewlite-api.onrender.com - CORS & /health)

web_prod --> api_prod : HTTPS :443\n(Public URL - SSR / Proxy)
api_prod --> db_prod : PostgreSQL :5432\n(Render Internal Private URL)

runner --> web_prod : Trigger Deploy Hook
runner --> api_prod : Trigger Deploy Hook
ghcr --> web_prod : pull image
ghcr --> api_prod : pull image

note right of web_prod
  <b>Health Check:</b> GET /menu
  <b>Build Args (Inlined at CI):</b>
  * NEXT_PUBLIC_API_URL
  * NEXT_PUBLIC_APP_URL
  <b>Runtime Env:</b>
  * PORT=3000
  * API_INTERNAL_URL=https://brewlite-api.onrender.com
end note

note bottom of api_prod
  <b>Health Check:</b> GET /health (HTTP 200)
  <b>Runtime Env (Render Secrets):</b>
  * DATABASE_URL (Internal Private URL)
  * JWT_SECRET, JWT_EXPIRES_IN=1d
  * FRONTEND_URL=https://brewlite-web.onrender.com
  * PORT=3001, NODE_ENV=production
  * ADMIN_EMAIL, ADMIN_PASSWORD
end note

note right of db_prod
  <b>Persistent Volume:</b> Render Managed Storage
  <b>Access Control:</b> Private Network Only
  <b>Lưu ý miễn phí:</b> Hết hạn sau 30 ngày (+14 ngày gia hạn)
end note

@enduml
