@startuml architecture-c4
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title BrewLite – Sơ đồ kiến trúc (C4 Container)

Person(customer, "Khách hàng", "Đăng nhập, xem menu, đặt đơn, thanh toán bằng QR chuyển tiền, theo dõi và hủy đơn, xem lịch sử")
Person(staff, "Nhân viên (ADMIN)", "Đối chiếu sao kê, xác nhận hoặc từ chối thanh toán, duyệt yêu cầu hủy, pha chế")

System_Boundary(brewlite, "BrewLite (monorepo: apps/web, apps/api, docs)") {
  Container(web, "Frontend (apps/web)", "Next.js (mobile-first/PWA), TailwindCSS, React Query, Zustand", "Giao diện khách hàng và trang quản trị; Zustand giữ giỏ hàng; React Query gọi API và polling trạng thái đơn")
  Container(api, "Backend API (apps/api)", "NestJS, REST/JSON", "Chia module theo domain: auth, products, inventory, orders, payments, vouchers; xác thực JWT, phân quyền CUSTOMER/ADMIN")
  Container(mockbank, "Ngân hàng giả lập (mock-bank)", "Module NestJS, cùng tiến trình với API", "Sinh QR theo đơn, trang chuyển tiền mở bằng QR (không cần đăng nhập), ghi sao kê, hoàn tiền; không có callback, nhân viên xác nhận thanh toán")
  ContainerDb(db, "PostgreSQL", "PostgreSQL + TypeORM", "Người dùng, sản phẩm, nguyên liệu và công thức, đơn, thanh toán, sao kê, voucher; migration tự chạy khi API khởi động")
}

Rel(customer, web, "Dùng trình duyệt / PWA", "HTTPS")
Rel(staff, web, "Dùng trang quản trị", "HTTPS")
Rel(web, api, "Gọi API, kèm JWT và Idempotency-Key", "HTTPS/JSON")
Rel(api, mockbank, "Tạo phiên QR, hoàn tiền", "Gọi nội bộ trong tiến trình")
Rel(api, db, "Đọc / ghi dữ liệu", "SQL (TypeORM)")
Rel(mockbank, db, "Ghi sao kê và phiên thanh toán", "SQL (TypeORM)")
@enduml